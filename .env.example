# Neon Postgres Database URLs
# DATABASE_URL (Pooled connection for Next.js application runtime)
DATABASE_URL=
# DATABASE_URL_UNPOOLED (Direct connection for Drizzle migrations & CLI tools)
DATABASE_URL_UNPOOLED=

# Better Auth Configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Admin Seed Account
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_INITIAL_PASSWORD=

# Security & Rate Limiting
IP_HASH_SALT=

# Optional Notification Integrations (Phase 7)
RESEND_API_KEY=
NOTIFY_ADMIN_EMAIL=

# Stand-in Image Policy
ALLOW_STANDIN_IMAGES=true
